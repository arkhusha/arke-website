# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
# HTML, CSS and JS keep the default (always revalidate). CSS/JS links carry ?v= versions anyway.
# Images and videos: browsers keep them for 7 days. Fonts never change: 1 year.
/assets/*
  Cache-Control: public, max-age=604800
/images/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
